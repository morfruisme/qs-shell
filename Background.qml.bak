import Quickshell
import Quickshell.Wayland
import Quickshell.Io
import QtQuick

pragma ComponentBehavior: Bound

Scope {
    id: root

    property alias folderPath: wallpaper.folderPath
    property alias fileName: wallpaper.fileName

    QtObject {
        id: wallpaper
        property string folderPath: "/home/fruit/Pictures"
        property string fileName
        readonly property string path: folderPath + "/" + fileName
        property real scale: 0.0
    }



    QtObject {
        id: bgSpace
        property int x
        property int y
        property int width
        property int height

        function compute() {
            let s0 = Quickshell.screens[0]
            
            let minX = s0.x
            let minY = s0.y
            let maxX = s0.x + s0.width
            let maxY = s0.y + s0.height

            Quickshell.screens.forEach(s => {
                if (s.x            < minX) minX = s.x
                if (s.y            < minY) minY = s.x
                if (s.x + s.width  > maxX) maxX = s.x + s.width
                if (s.y + s.height > maxY) maxY = s.y + s.height   
            })

            x = minX
            y = minY
            width  = maxX - minX
            height = maxY - minY
        }
    }

    Component.onCompleted: bgSpace.compute()



    Process {
        id: imageSizeProc
        command: ["identify", "-format", "%wx%h", wallpaper.path]
        running: true
        stdout: StdioCollector {
            onStreamFinished: {
                let [w, h] = this.text.split("x").map(x => parseInt(x))
                wallpaper.scale = Math.min(w / bgSpace.width, h / bgSpace.height)
            }
        }
    }


    
    Variants {
        model: Quickshell.screens

        delegate: PanelWindow {
            id: bg
            WlrLayershell.layer: WlrLayer.Background
            
            required property var modelData
            screen: modelData
    
            anchors {
                top: true
                bottom: true
                left: true
                right: true
            }


            // todo: loading anim ?
            Loader {
                anchors.fill: parent
                asynchronous: true
                active: wallpaper.scale > 0.0

                sourceComponent: Image {
                    anchors.fill: parent
                    asynchronous: true

                    source: wallpaper.path
                    sourceClipRect: Qt.rect(
                        wallpaper.scale * (bg.screen.x - bgSpace.x),
                        wallpaper.scale * (bg.screen.y - bgSpace.y),
                        wallpaper.scale * bg.screen.width,
                        wallpaper.scale * bg.screen.height
                    )
                }
            }

        }
    }
}
